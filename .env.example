NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# URL pública canónica de TurnIA. En producción el código fuerza este
# dominio propio para links públicos; se documenta también para staging/dev.
APP_URL=https://www.turniahealth.com.ar

# WhatsApp Business Platform (Meta Cloud API) — server-side only, nunca
# NEXT_PUBLIC_. Si se dejan vacías, el envío queda en modo seguro: no se
# intenta ninguna llamada real y el intento se registra como "failed" con un
# motivo claro en appointment_messages.error_message.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=appointment_created
WHATSAPP_TEMPLATE_LANG=es_AR
WHATSAPP_GRAPH_API_VERSION=v20.0

# Webhook de Meta (GET de verificación) — token arbitrario que elegís vos y
# configurás IGUAL acá y en Meta (App > WhatsApp > Configuration). No es un
# secreto de firma, sólo evita que cualquiera "verifique" el webhook.
WHATSAPP_VERIFY_TOKEN=

# OBLIGATORIO para aceptar POST del webhook — App Secret de la app de Meta,
# usado para validar la firma X-Hub-Signature-256 de cada evento entrante
# (ver app/api/whatsapp/webhook/route.ts). Sin esta variable, el webhook
# rechaza TODOS los POST con 403 — no existe un modo que acepte eventos sin
# validar la firma. No confundir con WHATSAPP_ACCESS_TOKEN (ese es para
# ENVIAR mensajes; este es para VALIDAR los que Meta manda al webhook). No
# se acepta ningún alias (por ejemplo META_APP_SECRET) para esta variable.
WHATSAPP_APP_SECRET=

# OBLIGATORIA para aceptar POST del webhook de Mercado Pago (Checkout Pro /
# Orders API) — Secret Key de Webhooks de la app de Mercado Pago (Developer
# Dashboard > la app > Webhooks > "Secret key"), usada para validar la firma
# HMAC-SHA256 del header `x-signature` de cada notificación entrante (ver
# app/api/mercadopago/webhook/route.ts y lib/mercadopago/webhook-signature.ts).
# Sin esta variable, el webhook rechaza TODOS los POST con 500 — no existe un
# modo que acepte notificaciones sin validar la firma, ni siquiera en
# desarrollo. No confundir con MP_CLIENT_SECRET (ese es del OAuth para
# conectar la cuenta del profesional; este es para VALIDAR lo que Mercado
# Pago manda al webhook). No se acepta ningún alias para esta variable.
MP_WEBHOOK_SECRET=

# Supabase service role — SOLO server-side (lib/supabase/service.ts). Da
# acceso total, bypasseando RLS: nunca exponerla al browser, nunca
# NEXT_PUBLIC_. Se usa exclusivamente para leer/escribir
# google_oauth_connections (tokens de Google), que a propósito no es
# accesible ni siquiera al usuario dueño de la fila vía la publishable key.
# Sin esta variable, toda la integración de Google Calendar/Meet queda en
# modo seguro (no configurado): no se intenta ninguna operación.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth 2.0 — conexión de Google Calendar/Meet por profesional (no
# una cuenta compartida). Crear credenciales OAuth "Web application" en
# Google Cloud Console y agregar GOOGLE_REDIRECT_URI como Authorized
# redirect URI EXACTO. Server-side únicamente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.turniahealth.com.ar/api/google/oauth/callback

# OBLIGATORIA para que la integración de Google funcione — clave de cifrado
# en reposo (AES-256-GCM, ver lib/google/token-crypto.ts) de los
# access_token/refresh_token guardados en google_oauth_connections. Debe ser
# base64 de exactamente 32 bytes aleatorios, por ejemplo generada con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Server-side únicamente, nunca NEXT_PUBLIC_. NUNCA reutilizar
# GOOGLE_CLIENT_SECRET ni ningún otro secreto existente como esta clave. NO
# compartirla ni commitearla — quien tenga esta clave puede descifrar todos
# los tokens de Google guardados. Sin esta variable (o si no decodifica a
# exactamente 32 bytes), la integración de Google queda en modo seguro (no
# configurado): no se guarda ninguna conexión nueva, y las conexiones
# existentes no pueden leerse/descifrarse.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Email transaccional CENTRAL de TurnIA (no por profesional). Todavía sin
# proveedor real conectado (ver lib/email/provider.ts) — documentado para
# cuando se elija uno (ej. Resend, Postmark). Mientras EMAIL_API_KEY y
# EMAIL_FROM_ADDRESS estén vacíos, el envío queda en modo seguro y el
# intento se registra como "failed" en appointment_messages.error_message,
# igual que WhatsApp sin credenciales.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=TurnIA


# Transcripción de notas de voz — server-side únicamente. Se usa para
# convertir el audio temporal grabado en Sesiones/Seguimientos a texto.
# El archivo de audio no se persiste en TurnIA: se procesa en memoria durante
# la petición y se descarta al finalizar. Nunca usar prefijo NEXT_PUBLIC_.
OPENAI_API_KEY=


# Rate limiting persistente — secreto dedicado para derivar claves HMAC
# opacas antes de guardarlas en rate_limit_counters. Server-side únicamente,
# nunca NEXT_PUBLIC_. Debe ser largo y aleatorio; no reutilizar service role,
# secretos OAuth ni claves de cifrado.
RATE_LIMIT_KEY_SECRET=


# MisRX — receta electrónica. Integración server-side por profesional.
# MISRX_BASE_URL normalmente queda con el endpoint oficial; sólo cambiarla
# para homologación si MisRX entrega una URL específica.
MISRX_BASE_URL=https://misrx.com.ar/wsmvd

# Identificadores asignados oficialmente por MisRX/Preserfar a TurnIA.
# MISRX_SOFT_ID identifica al software integrador y es requerido para
# prescripción externa. MISRX_APP_ID se reserva para operaciones de
# alta/onboarding que explícitamente lo requieran. No inventar valores.
MISRX_SOFT_ID=
MISRX_APP_ID=

# Clave independiente para cifrar credenciales MisRX en reposo (AES-256-GCM).
# Debe ser base64 estándar de exactamente 32 bytes. Nunca usar NEXT_PUBLIC_.
MISRX_CREDENTIAL_ENCRYPTION_KEY=

# Homologación MisRX. Activar sólo en preview/staging mientras se valida el
# circuito con Preserfar. Los IDs y datos de prueba se cargan como variables
# de entorno para evitar hardcodearlos en el código productivo.
MISRX_HOMOLOGATION_ENABLED=false
# Segundo bloqueo: aunque homologación esté activa, ninguna receta sale a MisRX
# hasta poner esta variable explícitamente en true en el entorno de preview.
MISRX_HOMOLOGATION_ISSUING_ENABLED=false
MISRX_HOMOLOGATION_CONVENTION_ID=
MISRX_HOMOLOGATION_DOCTOR_ID=
MISRX_HOMOLOGATION_PATIENT_DNI=
MISRX_HOMOLOGATION_PATIENT_CREDENTIAL=

# Producción MisRX. Mantener false hasta completar homologación y aprobación
# del proveedor. El código productivo nunca emite si esta bandera no está
# explícitamente en true.
MISRX_PRODUCTION_ISSUING_ENABLED=false
MISRX_FEATURE_VISIBLE=false

# Preview redeploy marker for MisRX homologation
# homologation issue test redeploy 2026-09-23

# Digilogix — firma digital remota. Integración exclusivamente server-side.
# Preview redeploy marker 2026-09-23 onboarding-email
# Por seguridad, el valor por defecto apunta al ambiente TEST y las llamadas
# reales quedan bloqueadas aunque se carguen credenciales, hasta habilitar
# DIGILOGIX_LIVE_CALLS_ENABLED=true explícitamente en preview/homologación.
DIGILOGIX_BASE_URL=https://test.api.firmador.digilogix.com.ar/api
DIGILOGIX_FEATURE_VISIBLE=false
DIGILOGIX_LIVE_CALLS_ENABLED=false

# Componentes de la cadena de autenticación documentada por Digilogix:
#   LOGIN|dd/MM/yyyy|CLIENTE|PASSWORD
# Cargar EXACTAMENTE los valores asignados por el proveedor. Server-side,
# nunca NEXT_PUBLIC_, nunca commitear valores reales.
DIGILOGIX_AUTH_LOGIN=
DIGILOGIX_AUTH_CLIENT=
DIGILOGIX_AUTH_PASSWORD=

# Parámetros criptográficos entregados por Digilogix para derivar/cifrar el
# header Authorization. En el ejemplo C# del proveedor, DIGILOGIX_IV es la
# variable denominada "Key" y debe resultar en 16 bytes ASCII.
DIGILOGIX_PRIVATE_KEY=
DIGILOGIX_SALT=
DIGILOGIX_IV=

# Header IdentificadorUsuario asignado por Digilogix y EmpresaID para las
# solicitudes de firma. No inventar valores.
DIGILOGIX_USER_IDENTIFIER=
DIGILOGIX_COMPANY_ID=

# La fecha del token se genera con esta zona horaria. Mantener la indicada
# por el proveedor si Digilogix confirma otra convención.
DIGILOGIX_AUTH_TIMEZONE=America/Argentina/Buenos_Aires

