NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# WhatsApp Business Platform (Meta Cloud API) — server-side only, nunca
# NEXT_PUBLIC_. Si se dejan vacías, el envío queda en modo seguro: no se
# intenta ninguna llamada real y el intento se registra como "failed" con un
# motivo claro en appointment_messages.error_message.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=appointment_created
WHATSAPP_TEMPLATE_LANG=es_AR
WHATSAPP_GRAPH_API_VERSION=v20.0

# Webhook de Meta (GET de verificación) — token arbitrario que elegís vos y
# configurás IGUAL acá y en Meta (App > WhatsApp > Configuration). No es un
# secreto de firma, sólo evita que cualquiera "verifique" el webhook.
WHATSAPP_VERIFY_TOKEN=

# Opcional, todavía no configurado: App Secret de Meta para validar la firma
# X-Hub-Signature-256 de cada POST al webhook (ver app/api/whatsapp/webhook/route.ts).
# Mientras esté vacío, la validación de firma queda en modo seguro (no bloquea).
WHATSAPP_APP_SECRET=

# Supabase service role — SOLO server-side (lib/supabase/service.ts). Da
# acceso total, bypasseando RLS: nunca exponerla al browser, nunca
# NEXT_PUBLIC_. Se usa exclusivamente para leer/escribir
# google_oauth_connections (tokens de Google), que a propósito no es
# accesible ni siquiera al usuario dueño de la fila vía la publishable key.
# Sin esta variable, toda la integración de Google Calendar/Meet queda en
# modo seguro (no configurado): no se intenta ninguna operación.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth 2.0 — conexión de Google Calendar/Meet por profesional (no
# una cuenta compartida). Crear credenciales OAuth "Web application" en
# Google Cloud Console y agregar GOOGLE_REDIRECT_URI como Authorized
# redirect URI EXACTO. Server-side únicamente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://turn-ia-web.vercel.app/api/google/oauth/callback

# Email transaccional CENTRAL de TurnIA (no por profesional). Todavía sin
# proveedor real conectado (ver lib/email/provider.ts) — documentado para
# cuando se elija uno (ej. Resend, Postmark). Mientras EMAIL_API_KEY y
# EMAIL_FROM_ADDRESS estén vacíos, el envío queda en modo seguro y el
# intento se registra como "failed" en appointment_messages.error_message,
# igual que WhatsApp sin credenciales.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=TurnIA
